{
  "name": "@yusufceng1z/ding",
  "version": "0.0.5",
  "description": "Framework-agnostic toast engine: spring solver, timers, state machine.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node --test \"src/**/*.test.ts\" && vitest run",
    "typecheck": "tsc -p ."
  },
  "homepage": "https://ding.yusufcengiz.dev",
  "bugs": { "url": "https://github.com/YusufCeng1z/ding/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufCeng1z/ding.git",
    "directory": "packages/core"
  },
  "keywords": [
    "toast",
    "notification",
    "spring",
    "animation"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Yusuf Cengiz",
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.0"
  }
}
